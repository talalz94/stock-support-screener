# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Alpaca (free paper account at alpaca.markets) -- bars, universe, quotes.
ALPACA_KEY_ID=
ALPACA_SECRET=

# FRED (free key at fredaccount.stlouisfed.org) -- macro series. Optional:
# without it everything else still builds.
FRED_API_KEY=

# SEC EDGAR requires a real contact address in the User-Agent and returns 403
# without one. Format: "Project Name (you@example.com)".
SEC_USER_AGENT=Support Bounce Screener (you@example.com)

# Optional: absolute path to another project's .env to fall back on for
# credentials. Leave blank unless you know you need it.
SIBLING_ENV_PATH=
